---
import PageLayout from '../../layouts/PageLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Button from '../../components/Button.astro';
import Icon from '../../components/Icon.astro';
import StudioCTA from '../../components/StudioCTA.astro';
import { getTop10Brands } from '../../data/brands';
import { getBrandLink, AFFILIATE_REL } from '../../data/links';
import { breadcrumbSchema, itemListSchema } from '../../utils/schema';
import { url } from '../../utils/url';
import { getPosts } from '../../utils/posts';

const guangsuyunLink = getBrandLink('guangsuyun');
const top10 = getTop10Brands().slice(0, 4);

const allPosts = await getPosts();
const relatedPosts = allPosts.filter(p => 
  p.id.includes('client') || p.id.includes('tutorial') || p.id.includes('vpn')
).slice(0, 3);

const crumbs = [
  { name: '首页', href: '/' },
  { name: '使用教程', href: '/tutorial/' },
];

const categorySchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: '科学上网新手配置教程与出海指南 - 全平台客户端上手教程',
  description: '面向零基础出海用户的全平台科学上网配置指南，涵盖Clash Verge Rev、v2rayN、Shadowrocket及Sing-box图文操作步骤与常见排错技巧。',
  url: 'https://mianfeitizi.world/tutorial/',
};
---

<PageLayout
  seo={{
    title: '科学上网与客户端新手配置教程大全 | 2026年出海零基础指南',
    description:
      '针对 Windows、macOS、iOS、Android 全平台出海新手撰写的保姆级科学上网教程。涵盖 Clash Verge Rev 订阅导入、TUN 模式开启、Shadowrocket 小火箭配置、美区 Apple ID 注册与晚高峰断流急救。',
    image: '/media/journal/clash-verge-rev-flclash-v2rayn-shadowrocket-client-tutorial.webp',
    imageAlt: '科学上网新手配置教程与出海指南',
    schema: [
      categorySchema,
      breadcrumbSchema(crumbs, Astro.site),
      itemListSchema(
        '新手首选易上手、提供自研或一键导入的专线推荐',
        '后台界面清晰、新手文档健全且配备专属客服的优质服务商',
        top10.map((b, idx) => ({
          name: `${idx + 1}. ${b.name}`,
          url: `/brands/${b.slug}/`,
          description: b.tagline,
          position: idx + 1,
        })),
        Astro.site,
      ),
    ],
  }}
>
  <div class="page-hero-wrap">
    <header class="page-hero">
      <img
        class="page-hero__bg"
        src={url('/media/journal/clash-verge-rev-flclash-v2rayn-shadowrocket-client-tutorial.webp')}
        alt="科学上网新手配置教程背景图"
        width="2000"
        height="1125"
        loading="eager"
        fetchpriority="high"
      />
      <div class="container page-hero__inner">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <ol>
            {crumbs.map((c, i) => (
              <li>
                {i < crumbs.length - 1 ? <a href={url(c.href)}>{c.name}</a> : <span aria-current="page">{c.name}</span>}
              </li>
            ))}
          </ol>
        </nav>
        <p class="page-hero__eyebrow">Step-by-Step Guides / 使用教程</p>
        <h1 class="page-hero__title page-hero__title--plain">科学上网新手配置教程与出海指南</h1>
        <p class="page-hero__lead">
          第一次翻墙不知从何下手？买了好专线却不知道怎么在电脑或手机上用？本栏目为您准备了四大主流操作系统（Windows、macOS、iOS、Android）图文保姆级教程，涵盖免费客户端下载、订阅链接一键导入、TUN 网卡模式开启与常见报错急救。
        </p>
        <div class="page-hero__actions">
          <a class="btn btn--dark" href="#step-by-step">四大平台入门配置流程</a>
          <a class="btn btn--line" href="/faq/">查看 36+ 报错急救问答</a>
        </div>
      </div>
    </header>
  </div>

  <!-- 子栏目导航矩阵 -->
  <section class="section section--sand">
    <div class="container">
      <div class="subnav-grid">
        <a class="subnav-card" href="/clash/">
          <span class="subnav-card__tag">Core</span>
          <h3>Clash 进阶教程</h3>
          <p>Mihomo 内核高级分流规则配置、GEO 数据库更新与 DNS 防泄露实操。</p>
          <span class="link-arrow">查看进阶规则 <Icon name="arrow-right" size={14} /></span>
        </a>
        <a class="subnav-card" href="/clients/">
          <span class="subnav-card__tag">Download</span>
          <h3>客户端下载大全</h3>
          <p>免翻墙高速直链下载 Clash Verge、FlClash、v2rayN 与 Sing-box。</p>
          <span class="link-arrow">获取官方客户端 <Icon name="arrow-right" size={14} /></span>
        </a>
        <a class="subnav-card" href="/free/">
          <span class="subnav-card__tag">Tools</span>
          <h3>免费出海工具箱</h3>
          <p>免费注册美区 Apple ID 步骤、加密 DNS 配置与免费 AI 平台直达。</p>
          <span class="link-arrow">浏览免费工具 <Icon name="arrow-right" size={14} /></span>
        </a>
        <a class="subnav-card" href="/jichang/">
          <span class="subnav-card__tag">Airport</span>
          <h3>新手友好专线</h3>
          <p>后台提供完整一键导入按钮、不卡顿且客服响应迅速的品牌排行。</p>
          <span class="link-arrow">挑选入门专线 <Icon name="arrow-right" size={14} /></span>
        </a>
      </div>
    </div>
  </section>

  <!-- 栏目说明与全平台快速指南 -->
  <section class="section" id="step-by-step">
    <div class="container">
      <SectionHeading
        title="栏目说明：三大基础步骤，3 分钟完成全平台翻墙配置"
        intro="无论您使用何种设备，科学上网的本质均遵循「购买专线订阅 -> 安装对应客户端 -> 导入订阅开启代理」的标准闭环。"
      />

      <div class="prose" style="max-width: 100%;">
        <div class="faq-card" style="margin-bottom: 24px; padding: 24px; background: var(--color-mist); border-radius: 8px;">
          <h3 style="margin-top: 0;">第一步：获取一条高速稳定的专线机场订阅链接（Subscription URL）</h3>
          <p>
            客户端本身只是一款本地代理软件，并不自带任何海外网络线路。您首先需要在正规专线服务商处注册账号并开通套餐，在用户中心复制**专属订阅链接**（形如 `https://.../api/v1/client/subscribe?token=...`）。首推 **TOP 1 光速云（99元/年，月均 8 元）**，后台支持 Clash、v2rayN、Shadowrocket 等原生一键导入。
          </p>
        </div>

        <div class="faq-card" style="margin-bottom: 24px; padding: 24px; background: var(--color-mist); border-radius: 8px;">
          <h3 style="margin-top: 0;">第二步：根据操作系统下载并安装推荐的开源代理客户端</h3>
          <ul>
            <li><strong>Windows 电脑</strong>：首选 **Clash Verge Rev** 或 **v2rayN**（解压即用，支持一键开启系统代理与 TUN 虚拟网卡）；</li>
            <li><strong>Mac 苹果电脑</strong>：首选 **Clash Verge Rev (macOS DMG)**，完美兼容 Apple Silicon M1/M2/M3/M4 芯片；</li>
            <li><strong>iPhone / iPad</strong>：推荐美区 App Store 购买下载 **Shadowrocket（小火箭，2.99 美元）**，或免费下载 **Karing / sing-box**；</li>
            <li><strong>Android 安卓手机</strong>：推荐免费开源的 **FlClash** 或 **v2rayNG**，界面现代化且极度省电。</li>
          </ul>
        </div>

        <div class="faq-card" style="margin-bottom: 24px; padding: 24px; background: var(--color-mist); border-radius: 8px;">
          <h3 style="margin-top: 0;">第三步：导入订阅链接并选择「规则模式（Rule）」启动代理</h3>
          <p>
            打开客户端 -> 点击「配置 / Profiles」 -> 粘贴刚才在光速云复制的订阅链接并点击「保存 / 下载」。成功刷出几十个香港、日本、美国、新加坡节点后，代理模式建议选择**「Rule（规则分流）」**——国内百度、微信、淘宝流量不走代理且不扣流量，海外访问 Google、YouTube、ChatGPT 自动秒开！
          </p>
        </div>
      </div>

      <!-- 核心转化展台：TOP 1 光速云 -->
      <div class="conversion-callout" style="margin-top: 32px;">
        <div class="conversion-callout__badge">新手友好 · 一键导入零门槛</div>
        <h3 class="conversion-callout__title">TOP 1 光速云（GuangSuYun）—— 后台自带全平台客户端一键导入配置</h3>
        <p class="conversion-callout__desc">
          专为出海新手深度打磨：用户中心提供 Windows、Mac、iOS、Android 四大系统的「一键导入 Clash」与「一键导入 Shadowrocket」按钮，无需手动繁琐复制粘贴。<strong>轻量版 99元/年（折合每月仅 8 元）</strong>，结账输入 9 折码 <strong>AMM</strong>，3 分钟即可畅快体验 4K 与 GPT-4o。
        </p>
        <div class="conversion-callout__actions">
          <a class="btn btn--dark" href={guangsuyunLink.registerUrl} target="_blank" rel={AFFILIATE_REL}>
            立即注册开通光速云（9折码 AMM）<Icon name="arrow-up" size={14} />
          </a>
          <a class="btn btn--line" href="/brands/guangsuyun/">查看光速云新手图文教程</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 推荐专线服务商 -->
  <section class="section section--mist">
    <div class="container">
      <SectionHeading
        title="新手首推高品质稳定专线机场"
        intro="后台交互简洁、提供一键导入和新手视频教程的推荐服务商。"
      >
        <Button href="/brands/">查看全部 42 家机场评测库</Button>
      </SectionHeading>

      <div class="brand-cards-grid">
        {top10.map((brand) => {
          const link = getBrandLink(brand.slug);
          return (
            <article class="brand-dir-card brand-dir-card--featured">
              <div class="brand-dir-card__top">
                <div class="brand-dir-card__badges">
                  <span class="rank-chip">#{brand.rank}</span>
                  <span class="tag">{brand.badge}</span>
                </div>
                {brand.speedtestEvidence && <span class="mini-status mini-status--measured">含实测图</span>}
              </div>
              <h3 class="brand-dir-card__title">
                <a href={url(`/brands/${brand.slug}/`)}>{brand.name}</a>
              </h3>
              <p class="brand-dir-card__tagline">{brand.tagline}</p>
              <dl class="brand-dir-card__specs">
                <div>
                  <dt>新手友好度</dt>
                  <dd>全平台一键导入 / 原生支持</dd>
                </div>
                <div>
                  <dt>代表价格</dt>
                  <dd>{brand.pricingSummary}</dd>
                </div>
                <div>
                  <dt>专属折扣码</dt>
                  <dd><strong class="coupon-highlight">{link.couponCode} ({link.couponDiscount})</strong></dd>
                </div>
              </dl>
              <div class="brand-dir-card__actions">
                <a class="btn btn--dark" href={link.registerUrl} target="_blank" rel={AFFILIATE_REL}>
                  前往官网一键开通 <Icon name="arrow-up" size={14} />
                </a>
                <a class="btn btn--line" href={url(`/brands/${brand.slug}/`)}>查看评测</a>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- 栏目相关文章 -->
  <section class="section">
    <div class="container">
      <SectionHeading
        title="客户端配置与协议调优进阶教程"
        intro="跟随技术指南一步步配置 TUN 虚拟网卡模式、DNS 防泄漏与 ChatGPT/Claude 分流规则。"
      />
      <div class="journal">
        {relatedPosts.map((post) => (
          <article class="post">
            <a class="post__media" href={url(`/journal/${post.id}/`)}>
              <img
                src={url(post.data.image)}
                alt={post.data.imageAlt}
                width="640"
                height="400"
                loading="lazy"
                decoding="async"
              />
            </a>
            <div class="post__body">
              <p class="post__meta">
                <span class="tag">{post.data.category}</span>
                <span>约 {post.data.readingTime ?? 8} 分钟阅读</span>
              </p>
              <h3 class="post__title">
                <a href={url(`/journal/${post.id}/`)}>{post.data.title}</a>
              </h3>
              <p class="post__excerpt">{post.data.description}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <StudioCTA />
</PageLayout>
