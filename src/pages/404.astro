---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
---

<BaseLayout title="页面未找到 (404)" description="您访问的页面不存在或已迁移。" noindex>
  <PageHero
    full
    image={{ src: '/media/banners/mountain-cloud-sea-404-hero.webp', alt: '404 页面未找到背景' }}
    eyebrow="404"
    title="节点迷航"
    words={[{ text: '路由' }, { text: '未找到', serif: true }]}
    lead="您访问的链接可能已调整。不妨直接返回首页或前往 42 家机场评测库查找最新节点资料。"
  >
    <div class="page-hero__actions">
      <Button href="/" variant="light">返回网站首页</Button>
      <Button href="/brands/" variant="glass">查看 42 家机场库</Button>
    </div>
  </PageHero>
</BaseLayout>
