---
import PageLayout from '../../layouts/PageLayout.astro';
import PostCard from '../../components/PostCard.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Newsletter from '../../components/Newsletter.astro';
import Icon from '../../components/Icon.astro';
import { getPosts, postMinutes } from '../../utils/posts';
import { formatDate } from '../../utils/format';
import { breadcrumbSchema } from '../../utils/schema';
import { url } from '../../utils/url';

const posts = await getPosts();
const [featured, ...rest] = posts;
const categories = [...new Set(posts.map((p) => p.data.category))];
const crumbs = [
  { name: '首页', href: '/' },
  { name: '深度评测专栏', href: '/journal/' },
];
---

<PageLayout
  seo={{
    title: '科学上网深度评测与教程专栏',
    description: '涵盖 2026 免费梯子安全分析、IEPL 专线机场选型、ChatGPT 与 Netflix 4K 解锁攻略及全平台代理客户端配置教程。',
    image: '/media/banners/journal-editorial-stones-hero.webp',
    imageAlt: '科学上网深度评测与客户端配置教程专栏',
    schema: [breadcrumbSchema(crumbs, Astro.site)],
  }}
  hero={{
    image: { src: '/media/banners/journal-editorial-stones-hero.webp', alt: '深度评测与技术专栏背景' },
    title: '深度评测专栏',
    words: [{ text: '深度评测' }, { text: '技术专栏', serif: true }],
    lead: '从免费梯子避坑指南、IEPL/IPLC 物理专线拆解，到 ChatGPT 解锁与客户端进阶分流配置。',
    breadcrumbs: crumbs,
  }}
>
  {featured ? (
    <>
      <section class="section" aria-labelledby="featured-title">
        <div class="container">
          <h2 class="sr-only" id="featured-title">置顶深度文章</h2>
          <a class="post post-feature" href={url(`/journal/${featured.id}/`)}>
            <div class="post__media">
              <img src={url(featured.data.image)} alt={featured.data.imageAlt} width="1600" height="1000" loading="eager" decoding="async" />
            </div>
            <div>
              <div class="post__meta">
                <span>最新精选</span>
                <span>{featured.data.category}</span>
                <span>约 {postMinutes(featured)} 分钟阅读</span>
                <time datetime={featured.data.pubDate.toISOString()}>{formatDate(featured.data.pubDate)}</time>
              </div>
              <h3>{featured.data.title}</h3>
              <p class="post-feature__excerpt">{featured.data.description}</p>
              <span class="link-arrow">阅读完整评测 <Icon name="arrow-up" size={14} /></span>
            </div>
          </a>
        </div>
      </section>

      {rest.length > 0 && (
        <section class="section section--mist" aria-labelledby="all-posts-title">
          <div class="container">
            <SectionHeading id="all-posts-title" title="全部专题文章" intro="每一篇均结合真实节点测试与 2026 最新协议生态撰写。">
              <ul class="topics" aria-label="专题分类">
                {categories.map((category) => <li><span class="tag">{category}</span></li>)}
              </ul>
            </SectionHeading>
            <div class="journal">
              {rest.map((post) => <PostCard post={post} showExcerpt showDate />)}
            </div>
          </div>
        </section>
      )}
    </>
  ) : (
    <section class="section">
      <div class="container">
        <p>深度评测文章正在更新中。</p>
      </div>
    </section>
  )}

  <Newsletter flush={false} />
</PageLayout>
