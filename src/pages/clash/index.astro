---
import PageLayout from '../../layouts/PageLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Button from '../../components/Button.astro';
import Icon from '../../components/Icon.astro';
import StudioCTA from '../../components/StudioCTA.astro';
import { getTop10Brands } from '../../data/brands';
import { getBrandLink, AFFILIATE_REL } from '../../data/links';
import { breadcrumbSchema, itemListSchema } from '../../utils/schema';
import { url } from '../../utils/url';
import { getPosts } from '../../utils/posts';

const guangsuyunLink = getBrandLink('guangsuyun');
const top10 = getTop10Brands().slice(0, 4);

const allPosts = await getPosts();
const relatedPosts = allPosts.filter(p => 
  p.id.includes('client') || p.id.includes('protocol') || p.id.includes('chatgpt')
).slice(0, 3);

const crumbs = [
  { name: '首页', href: '/' },
  { name: 'Clash教程与客户端', href: '/clash/' },
];

const categorySchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Clash配置教程与现代客户端大全 - 2026年Mihomo与Clash Verge Rev指南',
  description: '详解Clash原版停更后基于Mihomo内核的现代客户端选型、订阅转换、规则分流与DNS防泄露配置最佳实践。',
  url: 'https://mianfeitizi.world/clash/',
};
---

<PageLayout
  seo={{
    title: 'Clash配置教程与现代客户端大全 | Clash Verge Rev / FlClash 订阅配置指南',
    description:
      '2026 年 Clash 原版停更后的全新客户端选型与配置指南。详解基于 Mihomo (Clash.Meta) 内核的 Clash Verge Rev、FlClash、Sing-box 订阅导入、分流规则优化与 DNS 防泄露配置。',
    image: '/media/sessions/multi-platform-client-preview.webp',
    imageAlt: 'Clash配置教程与现代客户端选型指南',
    schema: [
      categorySchema,
      breadcrumbSchema(crumbs, Astro.site),
      itemListSchema(
        '支持现代Clash与VLESS协议的一线专线推荐',
        '全面兼容Mihomo内核与一键导入订阅的优质服务商',
        top10.map((b, idx) => ({
          name: `${idx + 1}. ${b.name}`,
          url: `/brands/${b.slug}/`,
          description: b.tagline,
          position: idx + 1,
        })),
        Astro.site,
      ),
    ],
  }}
>
  <div class="page-hero-wrap">
    <header class="page-hero">
      <img
        class="page-hero__bg"
        src={url('/media/sessions/multi-platform-client-preview.webp')}
        alt="Clash配置与客户端指南背景图"
        width="2000"
        height="1125"
        loading="eager"
        fetchpriority="high"
      />
      <div class="container page-hero__inner">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <ol>
            {crumbs.map((c, i) => (
              <li>
                {i < crumbs.length - 1 ? <a href={url(c.href)}>{c.name}</a> : <span aria-current="page">{c.name}</span>}
              </li>
            ))}
          </ol>
        </nav>
        <p class="page-hero__eyebrow">Clash & Mihomo Ecosystem / 客户端指南</p>
        <h1 class="page-hero__title page-hero__title--plain">Clash 配置教程与现代客户端选型指南</h1>
        <p class="page-hero__lead">
          2023 年旧版 Clash for Windows (CFW) 与 Clash for Android (CFA) 全网删库停更后，为何导入现代专线机场订阅频繁报错？本栏目为您梳理搭载新一代开源 Mihomo (Clash.Meta) 内核的现代化客户端选型、订阅转换防泄露与规则分流最佳实践。
        </p>
        <div class="page-hero__actions">
          <a class="btn btn--dark" href="/clients/">全平台客户端下载</a>
          <a class="btn btn--line" href="#rules-config">Clash 规则分流实操</a>
        </div>
      </div>
    </header>
  </div>

  <!-- 子栏目导航矩阵 -->
  <section class="section section--sand">
    <div class="container">
      <div class="subnav-grid">
        <a class="subnav-card" href="/clients/">
          <span class="subnav-card__tag">Download</span>
          <h3>全平台客户端下载</h3>
          <p>Clash Verge Rev、FlClash、v2rayN、Shadowrocket 官方开源下载渠道。</p>
          <span class="link-arrow">前往下载中心 <Icon name="arrow-right" size={14} /></span>
        </a>
        <a class="subnav-card" href="/tutorial/">
          <span class="subnav-card__tag">Tutorial</span>
          <h3>小白上手教程</h3>
          <p>Windows、macOS、iOS、Android 四大操作系统零基础配置图文教程。</p>
          <span class="link-arrow">查看新手教程 <Icon name="arrow-right" size={14} /></span>
        </a>
        <a class="subnav-card" href="/faq/">
          <span class="subnav-card__tag">Troubleshoot</span>
          <h3>报错与急救百科</h3>
          <p>解决订阅导入 403/500、节点全是 0ms 或 Timeout、TUN 模式失效难题。</p>
          <span class="link-arrow">查看排错问答 <Icon name="arrow-right" size={14} /></span>
        </a>
        <a class="subnav-card" href="/jichang/">
          <span class="subnav-card__tag">Airports</span>
          <h3>兼容专线推荐</h3>
          <p>原生适配 Mihomo/Clash 订阅格式，一键导入免转换的优质专线品牌。</p>
          <span class="link-arrow">挑选高速专线 <Icon name="arrow-right" size={14} /></span>
        </a>
      </div>
    </div>
  </section>

  <!-- 栏目说明与技术深度 -->
  <section class="section" id="rules-config">
    <div class="container">
      <SectionHeading
        title="栏目说明：Clash 停更后的现代代理生态格局与三大核心法则"
        intro="不要再使用两年前停更的旧版 CFW 或随意使用第三方订阅转换网站，保护隐私并发挥专线全部性能。"
      />

      <div class="prose" style="max-width: 100%;">
        <div class="faq-card" style="margin-bottom: 24px; padding: 24px; background: var(--color-mist); border-radius: 8px;">
          <h3 style="margin-top: 0;">一、为什么 2026 年必须放弃旧版 Clash，改用 Clash Verge Rev？</h3>
          <p>
            老版 Clash（基于已归档的 Premium 内核）早已停止维护，存在未修复的内存越界漏洞，且**完全不认识 2026 年主流的 VLESS、Reality、Hysteria 2 等抗封锁新协议**。现代专线机场（如光速云、微风网络）为了防御封锁，节点几乎全量迁移至 VLESS 协议。如果您仍用旧版 CFW 导入订阅，会直接出现“全部节点红叉 / Timeout”或解析报错。
          </p>
          <p>
            目前全网公认的最佳替代者为开源的 **Clash Verge Rev**（支持 Windows/macOS/Linux，采用 Rust + Tauri 编写，内存占用仅 40MB）以及多平台自适应的 **FlClash**，它们均内置最新的 Mihomo (Clash.Meta) 内核，完美原生支持 VLESS、TUIC 与 WireGuard。
          </p>
        </div>

        <div class="faq-card" style="margin-bottom: 24px; padding: 24px; background: var(--color-mist); border-radius: 8px;">
          <h3 style="margin-top: 0;">二、第三方公共「订阅转换」的严重盗密与被盗用隐患</h3>
          <p>
            许多用户因客户端不支持某种协议，习惯把包含 Token 的专属订阅链接复制到网上的“在线订阅转换”网站。这是极度危险的行为！大量公开的公益转换后端会将用户提交的节点信息记录存库，并将其转卖为公开代理池。一旦您的节点被几千名黑客扫描撞库共用，轻则流量被瞬间耗尽，重则因出口脏 IP 导致您的 ChatGPT、Google 或银行账号被彻底封禁。
          </p>
          <p>
            <strong>正确做法</strong>：直接选用像 **TOP 1 光速云** 这样在后台直接提供标准化 Clash / Mihomo / v2rayN 原生多格式订阅的成熟服务商，杜绝任何中间环节转换。
          </p>
        </div>
      </div>

      <!-- 核心转化展台：TOP 1 光速云 -->
      <div class="conversion-callout" style="margin-top: 32px;">
        <div class="conversion-callout__badge">原生 Clash / Mihomo 完美支持</div>
        <h3 class="conversion-callout__title">TOP 1 光速云（GuangSuYun）—— 一键导入 Clash Verge，免任何订阅转换</h3>
        <p class="conversion-callout__desc">
          光速云后台针对 Clash Verge Rev、FlClash、Shadowrocket、v2rayN 深度优化，支持一键导入标准化 Mihomo YAML 订阅。全节点采用 IEPL 专线与 VLESS 协议，配备智能规则分流，国内网站直连不耗流量，海外秒开 4K 与 AI。<strong>年付 99元（约 8元/月）</strong>，结账输入 9 折码 <strong>AMM</strong> 即刻开启。
        </p>
        <div class="conversion-callout__actions">
          <a class="btn btn--dark" href={guangsuyunLink.registerUrl} target="_blank" rel={AFFILIATE_REL}>
            前往光速云官网一键导入（9折码 AMM）<Icon name="arrow-up" size={14} />
          </a>
          <a class="btn btn--line" href="/brands/guangsuyun/">查看光速云评测档案</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 推荐一线专线品牌 -->
  <section class="section section--mist">
    <div class="container">
      <SectionHeading
        title="全面兼容 Clash / Mihomo 规则的一线专线品牌"
        intro="以下专线品牌均提供原生 Clash 配置，支持自动更新节点、测速分组与故障备援。"
      >
        <Button href="/brands/">查看全部 42 家机场评测库</Button>
      </SectionHeading>

      <div class="brand-cards-grid">
        {top10.map((brand) => {
          const link = getBrandLink(brand.slug);
          return (
            <article class="brand-dir-card brand-dir-card--featured">
              <div class="brand-dir-card__top">
                <div class="brand-dir-card__badges">
                  <span class="rank-chip">#{brand.rank}</span>
                  <span class="tag">{brand.badge}</span>
                </div>
                {brand.speedtestEvidence && <span class="mini-status mini-status--measured">含实测图</span>}
              </div>
              <h3 class="brand-dir-card__title">
                <a href={url(`/brands/${brand.slug}/`)}>{brand.name}</a>
              </h3>
              <p class="brand-dir-card__tagline">{brand.tagline}</p>
              <dl class="brand-dir-card__specs">
                <div>
                  <dt>核心协议</dt>
                  <dd>{brand.protocols.join(' / ')}</dd>
                </div>
                <div>
                  <dt>线路属性</dt>
                  <dd>{brand.lineType}</dd>
                </div>
                <div>
                  <dt>专属折扣码</dt>
                  <dd><strong class="coupon-highlight">{link.couponCode} ({link.couponDiscount})</strong></dd>
                </div>
              </dl>
              <div class="brand-dir-card__actions">
                <a class="btn btn--dark" href={link.registerUrl} target="_blank" rel={AFFILIATE_REL}>
                  前往官网获取订阅 <Icon name="arrow-up" size={14} />
                </a>
                <a class="btn btn--line" href={url(`/brands/${brand.slug}/`)}>查看评测</a>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- 栏目相关文章 -->
  <section class="section">
    <div class="container">
      <SectionHeading
        title="客户端配置与协议调优进阶教程"
        intro="跟随技术指南一步步配置 TUN 虚拟网卡模式、DNS 防泄漏与 ChatGPT/Claude 分流规则。"
      />
      <div class="journal">
        {relatedPosts.map((post) => (
          <article class="post">
            <a class="post__media" href={url(`/journal/${post.id}/`)}>
              <img
                src={url(post.data.image)}
                alt={post.data.imageAlt}
                width="640"
                height="400"
                loading="lazy"
                decoding="async"
              />
            </a>
            <div class="post__body">
              <p class="post__meta">
                <span class="tag">{post.data.category}</span>
                <span>约 {post.data.readingTime ?? 8} 分钟阅读</span>
              </p>
              <h3 class="post__title">
                <a href={url(`/journal/${post.id}/`)}>{post.data.title}</a>
              </h3>
              <p class="post__excerpt">{post.data.description}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <StudioCTA />
</PageLayout>
