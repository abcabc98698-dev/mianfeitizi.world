---
import PageLayout from '../../layouts/PageLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Button from '../../components/Button.astro';
import Icon from '../../components/Icon.astro';
import StudioCTA from '../../components/StudioCTA.astro';
import { getTop10Brands } from '../../data/brands';
import { getBrandLink, AFFILIATE_REL } from '../../data/links';
import { breadcrumbSchema, itemListSchema } from '../../utils/schema';
import { url } from '../../utils/url';
import { getPosts } from '../../utils/posts';

const guangsuyunLink = getBrandLink('guangsuyun');
const measuredBrands = getTop10Brands().filter(b => Boolean(b.speedtestEvidence)).slice(0, 4);

const allPosts = await getPosts();
const relatedPosts = allPosts.filter(p => 
  p.id.includes('chatgpt') || p.id.includes('protocol') || p.id.includes('top-10')
).slice(0, 3);

const crumbs = [
  { name: '首页', href: '/' },
  { name: '节点测速与选型', href: '/nodes/' },
];

const categorySchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: '节点选型与海外测速全景指南 - 2026香港/日本/美国/新加坡原生IP评测',
  description: '汇集珠海联通9Gbps实测图档，深度评测香港超低延迟、日本流媒体、美国原生住宅IP及东南亚落地的晚高峰抗抖动能力。',
  url: 'https://mianfeitizi.world/nodes/',
};
---

<PageLayout
  seo={{
    title: '节点选型与海外测速全景指南 | 香港日本美国新加坡低延迟线路评测',
    description:
      '2026年全球节点选型全景实测指南。详解香港低延迟、日本多流媒体、美国原生住宅IP解封ChatGPT/Claude及新加坡节点性能。实测晚高峰测速图档与欺诈分分析。首推 TOP 1 光速云（99元/年，折合8元/月，9折码 AMM）。',
    image: '/media/sessions/iepl-high-speed-node-preview.webp',
    imageAlt: '海外落地节点选型与测速全景指南',
    schema: [
      categorySchema,
      breadcrumbSchema(crumbs, Astro.site),
      itemListSchema(
        '含真实测速图档的高速专线机场推荐',
        '晚高峰实测跑满千兆且流媒体全解锁的优质落地节点',
        measuredBrands.map((b, idx) => ({
          name: `${idx + 1}. ${b.name}`,
          url: `/brands/${b.slug}/`,
          description: b.tagline,
          position: idx + 1,
        })),
        Astro.site,
      ),
    ],
  }}
>
  <div class="page-hero-wrap">
    <header class="page-hero">
      <img
        class="page-hero__bg"
        src={url('/media/sessions/iepl-high-speed-node-preview.webp')}
        alt="海外落地节点选型指南背景图"
        width="2000"
        height="1125"
        loading="eager"
        fetchpriority="high"
      />
      <div class="container page-hero__inner">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <ol>
            {crumbs.map((c, i) => (
              <li>
                {i < crumbs.length - 1 ? <a href={url(c.href)}>{c.name}</a> : <span aria-current="page">{c.name}</span>}
              </li>
            ))}
          </ol>
        </nav>
        <p class="page-hero__eyebrow">Node Performance & Latency / 节点测速</p>
        <h1 class="page-hero__title page-hero__title--plain">海外落地节点选型与测速全景指南</h1>
        <p class="page-hero__lead">
          节点不是越多越好，落地质量才是关键。本栏目结合珠海联通 9Gbps 与电信千兆晚高峰双重测试环境，系统剖析香港（超低延迟）、日本（高带宽）、美国（原生住宅 IP 完美解锁 AI）与新加坡节点的真实延迟与欺诈分指标。
        </p>
        <div class="page-hero__actions">
          <a class="btn btn--dark" href="#node-selection">全球主流地区节点选型</a>
          <a class="btn btn--line" href="/brands/guangsuyun/">查看光速云实测图档</a>
        </div>
      </div>
    </header>
  </div>

  <!-- 子栏目导航矩阵 -->
  <section class="section section--sand">
    <div class="container">
      <div class="subnav-grid">
        <a class="subnav-card" href="/jichang/">
          <span class="subnav-card__tag">Rank</span>
          <h3>专线机场排行榜</h3>
          <p>42家机场多维度性能排行榜，按实测千兆跑满率与稳定性综合排序。</p>
          <span class="link-arrow">查看专线排行榜 <Icon name="arrow-right" size={14} /></span>
        </a>
        <a class="subnav-card" href="/clash/">
          <span class="subnav-card__tag">Rule</span>
          <h3>分流规则设置</h3>
          <p>配置自动测速健康检查 (fallback/url-test) 与多地区负载均衡分组。</p>
          <span class="link-arrow">学习分流配置 <Icon name="arrow-right" size={14} /></span>
        </a>
        <a class="subnav-card" href="/free/">
          <span class="subnav-card__tag">Trial</span>
          <h3>免费试用节点</h3>
          <p>汇总 6 家支持新用户免费试用测速的专线机场，先白嫖再决定转正。</p>
          <span class="link-arrow">领取免费试用 <Icon name="arrow-right" size={14} /></span>
        </a>
        <a class="subnav-card" href="/faq/">
          <span class="subnav-card__tag">Unlock</span>
          <h3>流媒体与AI解锁</h3>
          <p>解决 Netflix 只能看自制剧、ChatGPT 提示 Access Denied 的根本手段。</p>
          <span class="link-arrow">解锁疑难解答 <Icon name="arrow-right" size={14} /></span>
        </a>
      </div>
    </div>
  </section>

  <!-- 节点地区选型指南 -->
  <section class="section" id="node-selection">
    <div class="container">
      <SectionHeading
        title="栏目说明：2026 全球主流节点地区选型矩阵与核心应用场景"
        intro="不同地区的落地节点在物理距离、网络出口纯净度及风控等级上差异显著，按需分流才能获得极致体验。"
      />

      <div class="prose" style="max-width: 100%;">
        <div class="faq-card" style="margin-bottom: 24px; padding: 24px; background: var(--color-mist); border-radius: 8px;">
          <h3 style="margin-top: 0;">🇭🇰 香港节点（Hong Kong）—— 超低延迟王者，日常网页与对战网游首选</h3>
          <p>
            通过广深 IEPL 物理专线过境，国内到香港的端到端单向延迟可控制在 4～12ms，几乎等同于国内局域网访问。极其适合对延迟要求苛刻的日常网页浏览、炒股交易、在线远程办公（Zoom/Teams）以及亚服游戏联机。但注意部分海外 AI 服务（如 Claude 官网）对香港 IP 实施地域封锁，需通过分流规则自动路由至美日节点。
          </p>
        </div>

        <div class="faq-card" style="margin-bottom: 24px; padding: 24px; background: var(--color-mist); border-radius: 8px;">
          <h3 style="margin-top: 0;">🇺🇸 美国节点（United States）—— 原生住宅 IP 典范，搞定 ChatGPT 与跨境电商</h3>
          <p>
            由于各大头部 AI 公司（OpenAI、Anthropic、Google）总部位于美国，美国本土节点享受最优先的 API 配额与最新功能灰度。选用纯净原生住宅 IP（Residential IP，风控欺诈分 Fraud Score 低于 15）的美国专线节点，能 100% 杜绝登录时频繁弹出的 Cloudflare 循环人机验证与封号风险。
          </p>
        </div>

        <div class="faq-card" style="margin-bottom: 24px; padding: 24px; background: var(--color-mist); border-radius: 8px;">
          <h3 style="margin-top: 0;">🇯🇵 日本 & 🇸🇬 新加坡节点 —— 4K 流媒体与亚洲泛用中枢</h3>
          <p>
            日本至国内的网络带宽极其充裕，且 Netflix、YouTube Premium、Disney+ 与 DMM 在日本区域资源最为丰富，是 4K 影音爱好者的必配节点；新加坡则是东南亚数据交换中心，对于 TikTok 海外版运营与东南亚跨境电商卖家（Shopee/Lazada）是必备基建。
          </p>
        </div>
      </div>

      <!-- 核心转化展台：TOP 1 光速云 -->
      <div class="conversion-callout" style="margin-top: 32px;">
        <div class="conversion-callout__badge">全节点原生纯净 IP</div>
        <h3 class="conversion-callout__title">TOP 1 光速云（GuangSuYun）—— 10国原生落地节点，全绿解锁 4K 与 AI</h3>
        <p class="conversion-callout__desc">
          光速云拥有覆盖港、台、日、新、美、英、法、德、土、阿根廷等 10 国的企业级原生专线落地。实验室实测晚高峰跑满 1000Mbps，YouTube 4K 秒开缓冲 150,000+ Kbps，全面解锁 ChatGPT-4o、Claude 3.5 Sonnet 与 Netflix 完整库。<strong>年付 99元（约 8元/月）</strong>，结账输入 9 折码 <strong>AMM</strong>。
        </p>
        <div class="conversion-callout__actions">
          <a class="btn btn--dark" href={guangsuyunLink.registerUrl} target="_blank" rel={AFFILIATE_REL}>
            体验光速云原生高速节点（9折码 AMM）<Icon name="arrow-up" size={14} />
          </a>
          <a class="btn btn--line" href="/brands/guangsuyun/">查看光速云测速图与解锁图</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 实测节点品牌卡片 -->
  <section class="section section--mist">
    <div class="container">
      <SectionHeading
        title="经 2026 晚高峰实测的高带宽节点服务商"
        intro="包含真实测速图证，晚高峰千兆带宽利用率超过 80% 的高稳定性品牌。"
      >
        <Button href="/brands/">查看全部 42 家机场评测库</Button>
      </SectionHeading>

      <div class="brand-cards-grid">
        {measuredBrands.map((brand) => {
          const link = getBrandLink(brand.slug);
          return (
            <article class="brand-dir-card brand-dir-card--featured">
              <div class="brand-dir-card__top">
                <div class="brand-dir-card__badges">
                  <span class="rank-chip">#{brand.rank}</span>
                  <span class="tag">{brand.badge}</span>
                </div>
                {brand.speedtestEvidence && <span class="mini-status mini-status--measured">含实测图</span>}
              </div>
              <h3 class="brand-dir-card__title">
                <a href={url(`/brands/${brand.slug}/`)}>{brand.name}</a>
              </h3>
              <p class="brand-dir-card__tagline">{brand.tagline}</p>
              <dl class="brand-dir-card__specs">
                <div>
                  <dt>覆盖地区</dt>
                  <dd>{brand.regions.slice(0, 4).join(' / ')} 等</dd>
                </div>
                <div>
                  <dt>代表价格</dt>
                  <dd>{brand.pricingSummary}</dd>
                </div>
                <div>
                  <dt>专属折扣码</dt>
                  <dd><strong class="coupon-highlight">{link.couponCode} ({link.couponDiscount})</strong></dd>
                </div>
              </dl>
              <div class="brand-dir-card__actions">
                <a class="btn btn--dark" href={link.registerUrl} target="_blank" rel={AFFILIATE_REL}>
                  前往官网获取节点 <Icon name="arrow-up" size={14} />
                </a>
                <a class="btn btn--line" href={url(`/brands/${brand.slug}/`)}>查看评测</a>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- 栏目相关文章 -->
  <section class="section">
    <div class="container">
      <SectionHeading
        title="节点选型与流媒体解锁深度阅读"
        intro="深入探究海外 IP 欺诈分、家庭宽带出口与流媒体封锁机制的攻防实录。"
      />
      <div class="journal">
        {relatedPosts.map((post) => (
          <article class="post">
            <a class="post__media" href={url(`/journal/${post.id}/`)}>
              <img
                src={url(post.data.image)}
                alt={post.data.imageAlt}
                width="640"
                height="400"
                loading="lazy"
                decoding="async"
              />
            </a>
            <div class="post__body">
              <p class="post__meta">
                <span class="tag">{post.data.category}</span>
                <span>约 {post.data.readingTime ?? 8} 分钟阅读</span>
              </p>
              <h3 class="post__title">
                <a href={url(`/journal/${post.id}/`)}>{post.data.title}</a>
              </h3>
              <p class="post__excerpt">{post.data.description}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <StudioCTA />
</PageLayout>
