---
import PageLayout from '../../layouts/PageLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Button from '../../components/Button.astro';
import Icon from '../../components/Icon.astro';
import StudioCTA from '../../components/StudioCTA.astro';
import { getFreeTrialBrands, getBudgetYearlyBrands, getUnlimitedDurationBrands } from '../../data/brands';
import { getBrandLink, AFFILIATE_REL, AFFILIATE_DISCLOSURE } from '../../data/links';
import {
  freePathComparisons,
  freeResourceTools,
  selfBuildComparison,
  clashDnsBestPracticeYaml,
} from '../../data/free-resources';
import { breadcrumbSchema, faqPageSchema, itemListSchema } from '../../utils/schema';
import { url } from '../../utils/url';

const freeTrialBrands = getFreeTrialBrands();
const budgetBrands = getBudgetYearlyBrands().slice(0, 8);
const unlimitedBrands = getUnlimitedDurationBrands().slice(0, 6);
const guangsuyunLink = getBrandLink('guangsuyun');

const crumbs = [
  { name: '首页', href: '/' },
  { name: '免费梯子与出海免费资源中心', href: '/free-nodes/' },
];

const freeFaqs = [
  {
    question: '2026年还有真正安全、好用的「免费梯子」吗？',
    answer:
      '如果是指「不明来源的永久免费 VPN App」或「电报群里所有人共用的免费 SSR/VMess 节点」，我们强烈建议远离——这类节点不仅晚高峰丢包率超过 80%，更普遍存在注入广告、嗅探 Cookie 和导致 ChatGPT/Google 账号被封禁的风险。真正安全稳妥的做法是：优先选择 TOP 1 光速云（99元/年折合每月仅 8 元，每天不到 0.27 元，9折码 AMM）或注册支持新用户免费试用的正规专线机场（如极连云、一翻云、闪跃、神行加速），先验证速度，满意后再长期留用。',
  },
  {
    question: 'Cloudflare WARP / Workers 免费节点和光速云 IEPL 专线有什么本质区别？',
    answer:
      'Cloudflare WARP 与 Workers 属于利用 Cloudflare 边缘 CDN 网络实现的免费代理技术。它的优点是零资金成本且大厂背书不泄密；但致命短板是国内三网（尤其是电信和移动）在晚高峰 20:00–23:00 对 Cloudflare Anycast IP 丢包严重，需要用户每周手动运行优选 IP 脚本维护，且无法自由切换港、台、日、新、美、土、阿等 10 国原生落地。相比之下，TOP 1 光速云采用广深 BGP 入口 + 企业级 IEPL 内网物理专线，无需任何技术维护即可全天候秒开 4K 视频与 GPT-4o，年付 99 元折合每天仅 2 毛 7 分钱。',
  },
  {
    question: '为什么用免费梯子登录 ChatGPT、Claude 或跨境电商后台极易被封号？',
    answer:
      '因为海外风控系统（如 Cloudflare Turnstile、Scamalytics 与 MaxMind）会实时记录每个 IP 地址的异常请求频率。一个公开的免费梯子出口 IP 每天往往有上千名不同用户共用，甚至被黑客用于批量撞库和发垃圾邮件，其欺诈风险分（Fraud Score）高达 90–100 分。一旦您的高价值账号从这种高危脏 IP 登录，平台风控模型会立即判定为机器滥用并永久封禁账号。',
  },
  {
    question: '不想买包月套餐白白浪费流量，最划算的低频替代方案是什么？',
    answer:
      '最适合低频用户的方案是「按量计费、永久不过期的不限时流量包」！例如 TOP 1 光速云的「致敬斯诺克147永久套餐」（147元一次性买断 247GB 企业级 IEPL 专线流量，叠加 9 折码 AMM 后仅需 132.3 元，每 GB 仅约 0.53 元）、Firefly 萤火虫的 100元/100GB 不限时包（用 8 折码 firefly 后仅需 80 元）、以及二猫云的 99元/100GB 不限时包（用 88 折码 ermao5555 后约 87.1 元）。买一次可以用上一两年，彻底告别月租清零焦虑。',
  },
  {
    question: '如何免费注册一个属于自己的美区 Apple ID 来下载小火箭或免费客户端 Karing？',
    answer:
      '完全不需要去淘宝买共享账号！只需打开苹果官方账号管理页（account.apple.com），点击创建新 Apple ID，国家/地区选择「美国」，邮箱填写一个未注册过苹果的邮箱，手机号直接填写您自己的「中国大陆 +86 手机号」即可正常接收短信验证码。注册成功后，打开 iPhone 上的 App Store（切记不要在系统设置 iCloud 登录），首次下载免费应用（如 Karing 或 sing-box）时补全账单地址，将州选为免税州 Oregon（俄勒冈，邮编 97201），付款方式选 None 即可。',
  },
  {
    question: '挂了梯子之后如何免费使用满血版 Gemini 2.5 Pro 和 DeepSeek R1 等大模型？',
    answer:
      '本页「免费 AI 大模型工具箱」为您整理了三大官方白嫖通道：1）切换至光速云的美国或新加坡节点（避开香港），登录 Google AI Studio (aistudio.google.com)，即可完全免费使用 100万上下文的 Gemini 2.5 Pro；2）访问 OpenRouter 筛选 `$0/M tokens` 的 `:free` 模型，免费调用 DeepSeek R1 与 Llama 3.3 70B；3）访问 DuckDuckGo AI Chat (duck.ai)，无需注册账号即可免费匿名对话。',
  },
];
---

<PageLayout
  seo={{
    title: '2026免费梯子与出海免费资源中心 | TOP 1 光速云平替、免费试用机场与30+开源工具大全',
    description:
      '万字级科学上网免费资源百科全书：涵盖 TOP 1 光速云（99元/年折合8元/月 IEPL 专线）、6家正规免费试用机场、Cloudflare/VPS自建成本对比，以及加密DNS、IP纯净度检测、开源分流规则、免费美区Apple ID与免费AI大模型导航矩阵。',
    image: '/media/immersions/coastal-cliff-reset-weekend.webp',
    imageAlt: '2026免费梯子真相、正规免费试用机场与出海免费工具资源中心',
    schema: [
      breadcrumbSchema(crumbs, Astro.site),
      faqPageSchema(freeFaqs),
      itemListSchema(
        '2026免费梯子平替与出海免费工具导航矩阵',
        '收录 TOP 1 光速云、正规免费试用机场及加密DNS、IP检测、开源分流规则与免费AI工作台',
        [
          ...freeTrialBrands.map((b, i) => ({
            name: `${b.name} (${b.tagline})`,
            url: `/brands/${b.slug}/`,
            description: b.summary,
            position: i + 1,
          })),
          ...freeResourceTools.map((t, i) => ({
            name: `${t.name} [${t.categoryLabel}]`,
            url: `/free-nodes/#tool-${t.id}`,
            description: t.summary,
            position: freeTrialBrands.length + i + 1,
          })),
        ],
        Astro.site,
      ),
    ],
  }}
  hero={{
    image: { src: '/media/immersions/coastal-cliff-reset-weekend.webp', alt: '免费梯子与出海免费资源百科中心背景' },
    eyebrow: 'MEGA PILLAR HUB · 免费梯子真相与出海免费资源导航矩阵',
    title: '免费梯子与免费资源百科',
    words: [{ text: '免费梯子' }, { text: '出海免费资源库', serif: true }],
    lead: '不仅帮您甄别野生免费 VPN 的隐私陷阱、找到 TOP 1 光速云（每天仅 0.27 元）与正规免费试用机场，更一站式汇总加密 DNS、IP 纯净度检测、开源分流规则、美区 Apple ID 直注与免费 AI 大模型等 6 大类硬核免费资源。',
    breadcrumbs: crumbs,
  }}
>
  <Fragment slot="hero">
    <div class="page-hero__actions">
      <Button href="#free-trials" variant="light">01 首选体验与免费试用</Button>
      <Button href="#path-comparison" variant="glass">02 六大免费路径对比</Button>
      <Button href="#free-toolbox" variant="glass">03 出海免费工具箱</Button>
      <Button href="#selfbuild-vs-iepl" variant="glass">04 自建VPS vs 光速云</Button>
      <Button href="#budget-yearly" variant="glass">05 百元年付 & 永久包</Button>
    </div>
  </Fragment>

  <!-- 模块 01：TOP 1 光速云领衔 & 支持正规免费试用的机场 -->
  <section class="section section--mist" id="free-trials" aria-labelledby="free-trials-title">
    <div class="container">
      <div class="compliance-banner">
        <p>{AFFILIATE_DISCLOSURE}</p>
      </div>

      <SectionHeading
        id="free-trials-title"
        title="01 / TOP 1 光速云领衔：支持「新用户注册体验与免费试用」的 6 家正规机场"
        intro="告别来路不明的高危免费节点：首推 2020 年老牌 IEPL 旗舰「光速云」（99元/年折合 8 元/月，每天不到 3 毛钱，9折码 AMM），同时汇总支持新用户免费试用的正规专线品牌。"
      >
        <Button href="/brands/">浏览全部 42 家机场库</Button>
      </SectionHeading>

      <div class="brand-cards-grid">
        {freeTrialBrands.map((brand) => {
          const link = getBrandLink(brand.slug);
          return (
            <article class="brand-dir-card brand-dir-card--featured">
              <div class="brand-dir-card__top">
                <div class="brand-dir-card__badges">
                  <span class="rank-chip">#{brand.rank}</span>
                  <span class="tag">{brand.freeTrialNote ?? '支持免费试用'}</span>
                </div>
                {brand.speedtestEvidence && <span class="mini-status mini-status--measured">含实测图</span>}
              </div>

              <h3 class="brand-dir-card__title">
                <a href={url(`/brands/${brand.slug}/`)}>{brand.name}</a>
              </h3>
              <p class="brand-dir-card__tagline">{brand.tagline}</p>

              <dl class="brand-dir-card__specs">
                <div>
                  <dt>核心线路</dt>
                  <dd>{brand.lineType} ({brand.protocols.join('/')})</dd>
                </div>
                <div>
                  <dt>套餐代表价格</dt>
                  <dd>{brand.pricingSummary}</dd>
                </div>
                <div>
                  <dt>专属折扣码</dt>
                  <dd><strong class="coupon-highlight">{link.couponCode} ({link.couponDiscount})</strong></dd>
                </div>
              </dl>

              <div class="brand-dir-card__actions">
                <a
                  class="btn btn--dark"
                  href={link.registerUrl}
                  target="_blank"
                  rel={AFFILIATE_REL}
                >
                  {brand.slug === 'guangsuyun' ? '前往光速云官网注册' : '前往注册免费试用'} <Icon name="arrow-up" size={14} />
                </a>
                <a class="btn btn--line" href={url(`/brands/${brand.slug}/`)}>查看评测</a>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- 模块 02：免费获取科学上网节点的 6 种路径深度对比 -->
  <section class="section" id="path-comparison" aria-labelledby="path-comparison-title">
    <div class="container">
      <SectionHeading
        id="path-comparison-title"
        title="02 / 2026 获取「免费梯子 / 低成本节点」的 6 种技术路径全景评估"
        intro="为什么懂网络安全的工程师从不碰野生免费 VPN？我们将市面上所有获取免费或微成本节点的途径放在同一张实验室对比表中，帮您看清隐性成本。"
      />

      <div class="table-scroll">
        <table class="comparison-table">
          <thead>
            <tr>
              <th>获取路径 / 方案类型</th>
              <th>实际成本</th>
              <th>延迟与带宽表现</th>
              <th>晚高峰 (20:00–23:00) 稳定性</th>
              <th>隐私与封号风险</th>
              <th>ChatGPT / 4K 流媒体支持</th>
              <th>实验室综合结论</th>
            </tr>
          </thead>
          <tbody>
            {freePathComparisons.map((row, idx) => (
              <tr class:list={{ 'is-top1': idx === freePathComparisons.length - 1 }}>
                <td><strong>{row.method}</strong></td>
                <td>{row.cost}</td>
                <td>{row.speedAndLatency}</td>
                <td>{row.stabilityInPeak}</td>
                <td>
                  <span class:list={[
                    'mini-status',
                    row.securityRisk.includes('极高危') ? 'mini-status--historical' : row.securityRisk.includes('安全') ? 'mini-status--measured' : 'mini-status--vendor',
                  ]}>
                    {row.securityRisk}
                  </span>
                </td>
                <td>{row.aiAndStreaming}</td>
                <td>{row.verdict}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- 模块 03：2026 出海免费工具与开源基础设施导航库（交互式筛选） -->
  <section class="section section--mist" id="free-toolbox" aria-labelledby="toolbox-title" data-free-toolbox>
    <div class="container">
      <SectionHeading
        id="toolbox-title"
        title="03 / 2026 出海必备「真实免费工具与开源资源导航矩阵」"
        intro="真正有价值的免费资源不是劣质公共节点，而是下面这 6 大类经全球开发者验证的免费数字基础设施：从防污染加密 DNS、IP 欺诈分体检，到免信用卡注册美区 Apple ID 与白嫖满血版 Gemini 2.5 Pro。"
      />

      <div class="filter-bar">
        <div class="filter-tabs" role="group" aria-label="免费资源分类筛选">
          <button type="button" class="filter-btn is-active" data-tool-filter="all">全部免费资源 ({freeResourceTools.length})</button>
          <button type="button" class="filter-btn" data-tool-filter="dns">加密 DNS 与防污染</button>
          <button type="button" class="filter-btn" data-tool-filter="ip-check">IP 纯净度与防封号体检</button>
          <button type="button" class="filter-btn" data-tool-filter="speed-route">节点测速与路由诊断</button>
          <button type="button" class="filter-btn" data-tool-filter="rules-sub">开源分流规则与订阅合并</button>
          <button type="button" class="filter-btn" data-tool-filter="identity-mail">免费美区 Apple ID 与邮箱</button>
          <button type="button" class="filter-btn" data-tool-filter="free-ai">免费 AI 大模型工作台</button>
        </div>
        <div class="filter-search">
          <label for="tool-search-input" class="sr-only">搜索免费工具名称或用途</label>
          <input
            id="tool-search-input"
            type="search"
            placeholder="搜索 DNS、Ping0、Apple ID、Gemini、规则集..."
            data-tool-search
          />
        </div>
      </div>

      <div class="client-cards-grid">
        {freeResourceTools.map((tool) => (
          <article
            class="client-card client-card--recommended"
            id={`tool-${tool.id}`}
            data-tool-card
            data-category={tool.category}
            data-search={`${tool.name} ${tool.categoryLabel} ${tool.summary} ${tool.howToUse} ${tool.proTip}`.toLowerCase()}
          >
            <div class="client-card__head">
              <div>
                <div class="brand-dir-card__badges">
                  <span class="mini-status mini-status--measured">{tool.categoryLabel}</span>
                  <span class="tag">{tool.badge}</span>
                </div>
                <h3 style="margin-top:10px">{tool.name}</h3>
              </div>
              <a
                class="btn btn--dark btn--sm"
                href={tool.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                官方直达 <Icon name="arrow-up" size={13} />
              </a>
            </div>

            <p class="client-card__summary">{tool.summary}</p>

            {tool.configSnippet && (
              <div class="client-card__meta">
                <div><strong>配置地址 / 镜像源：</strong><code>{tool.configSnippet}</code></div>
              </div>
            )}

            <div class="client-card__cols">
              <div>
                <h4>实操使用方法</h4>
                <p style="font-size:var(--fs-xs);color:var(--color-stone);line-height:1.6">{tool.howToUse}</p>
              </div>
              <div>
                <h4>实验室高阶技巧</h4>
                <p style="font-size:var(--fs-xs);color:var(--color-stone);line-height:1.6">{tool.proTip}</p>
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- 附：Clash 防 DNS 污染黄金 YAML 配置段 -->
      <article class="obs-card obs-card--full" style="margin-top:32px">
        <header class="obs-card__head">
          <div>
            <span class="obs-card__eyebrow">FREE CONFIG TEMPLATE · 免费开源覆写模板</span>
            <h3>Clash Verge Rev / FlClash 国内外分流防 DNS 污染黄金配置片段</h3>
          </div>
          <button
            type="button"
            class="btn btn--dark btn--sm"
            data-copy-yaml={clashDnsBestPracticeYaml}
          >
            一键复制 YAML 配置
          </button>
        </header>
        <p style="font-size:var(--fs-small);color:var(--color-stone);margin-bottom:16px">
          将以下配置粘入客户端的「全局扩展覆写配置 (Merge / Override YAML)」中，即可利用免费的阿里云/腾讯云 DoH 秒解国内网站，同时通过代理隧道调用 Cloudflare 1.1.1.1 解析海外被墙域名，彻底告别 DNS 泄露：
        </p>
        <pre class="code-block"><code>{clashDnsBestPracticeYaml}</code></pre>
      </article>
    </div>
  </section>

  <!-- 模块 04：自建免费/低价 VPS 梯子 vs TOP 1 光速云 99元/年硬核算账对比 -->
  <section class="section" id="selfbuild-vs-iepl" aria-labelledby="selfbuild-title">
    <div class="container">
      <SectionHeading
        id="selfbuild-title"
        title="04 / 技术流算账：自己折腾免费 Cloudflare / 低价 VPS 自建 vs 光速云 99元/年 IEPL 专线"
        intro="很多程序员或极客起初觉得「买台便宜海外 VPS 自己装 Xray，或者用 Cloudflare Workers 更划算」。我们来算一笔真实的金钱、带宽与时间账。"
      />

      <div class="table-scroll">
        <table class="comparison-table">
          <thead>
            <tr>
              <th>对比维度</th>
              <th>Cloudflare Workers / WARP 免费方案</th>
              <th>海外廉价 VPS 自建 ($15–$36/年)</th>
              <th>TOP 1 · 光速云轻量版 (99元/年 IEPL 专线)</th>
            </tr>
          </thead>
          <tbody>
            {selfBuildComparison.map((row) => (
              <tr>
                <td><strong>{row.dimension}</strong></td>
                <td>{row.cloudflareWorkers}</td>
                <td>{row.cheapVpsSelfBuild}</td>
                <td style="background:rgba(201,183,156,.14)"><strong>{row.guangsuyunTop1}</strong></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="conversion-callout">
        <div>
          <span class="tag">实验室算账结论</span>
          <h3>与其花几十个小时折腾优选脚本或承担 VPS IP 被墙风险，不如每天花 0.25 元一步到位</h3>
          <p>
            TOP 1 <strong>光速云 (Guangsuyun)</strong> 自 2020 年稳定运营至今，轻量版年付仅 <strong>¥99/年（每月 69GB 企业级 IEPL 专线，折合 ¥8.25/月）</strong>，使用本站核验优惠码 <code>AMM</code> 享 9 折后全年仅需 <strong>¥89.1</strong>！如果您更倾向按量买断，还可选择 <strong>¥147 / 247GB 斯诺克永久套餐</strong>。
          </p>
        </div>
        <div class="conversion-callout__actions">
          <a
            class="btn btn--dark"
            href={guangsuyunLink.registerUrl}
            target="_blank"
            rel={AFFILIATE_REL}
          >
            立即开通光速云 (9折码: AMM) <Icon name="arrow-up" size={14} />
          </a>
          <Button href="/brands/guangsuyun/" variant="line">查看光速云实测图与评测</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- 模块 05：百元内年付安全平替（月均 5.1 ~ 8.2 元）与永久不限时流量包 -->
  <section class="section section--mist" id="budget-yearly" aria-labelledby="budget-yearly-title">
    <div class="container">
      <SectionHeading
        id="budget-yearly-title"
