<script>
  document.querySelectorAll<HTMLElement>('[data-free-toolbox]').forEach((root) => {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-tool-filter]')];
    const searchInput = root.querySelector<HTMLInputElement>('[data-tool-search]');
    const cards = [...root.querySelectorAll<HTMLElement>('[data-tool-card]')];
    let activeCategory = 'all';

    const apply = () => {
      const q = (searchInput?.value ?? '').trim().toLowerCase();
      cards.forEach((card) => {
        const cat = card.dataset.category ?? '';
        const text = card.dataset.search ?? '';
        const matchCat = activeCategory === 'all' || cat === activeCategory;
        const matchQ = !q || text.includes(q);
        card.hidden = !(matchCat && matchQ);
      });
    };

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeCategory = btn.dataset.toolFilter ?? 'all';
        buttons.forEach((b) => b.classList.toggle('is-active', b === btn));
        apply();
      });
    });

    searchInput?.addEventListener('input', apply);
  });

  document.querySelectorAll<HTMLButtonElement>('[data-copy-yaml]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const yaml = btn.dataset.copyYaml ?? '';
      if (!yaml) return;
      try {
        await navigator.clipboard.writeText(yaml);
        const orig = btn.textContent;
        btn.textContent = '已复制 YAML 配置！';
        window.setTimeout(() => {
          btn.textContent = orig;
        }, 2000);
      } catch {
        // ignore
      }
    });
  });
</script>
