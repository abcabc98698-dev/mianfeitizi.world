---
import type { IconName } from '../types';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  label?: string;
}

const { name, size = 18, class: className, label } = Astro.props;
---

<svg
  width={size}
  height={size}
  class={className}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"><use href={`#icon-${name}`} /></svg>
