---
import SectionHeading from './SectionHeading.astro';
import Button from './Button.astro';
import ClassCard from './ClassCard.astro';
import { classes } from '../data/classes';
import { classesSection } from '../data/home';
---

<section class="section section--mist" id="sessions" aria-labelledby="sessions-title">
  <div class="container">
    <SectionHeading id="sessions-title" title={classesSection.title} intro={classesSection.intro}>
      {classesSection.cta && <Button href={classesSection.cta.href} variant="line">{classesSection.cta.label}</Button>}
    </SectionHeading>
    <div class="classes__grid">
      {classes.map((item) => <ClassCard item={item} />)}
    </div>
  </div>
</section>
