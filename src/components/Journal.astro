---
import SectionHeading from './SectionHeading.astro';
import Button from './Button.astro';
import PostCard from './PostCard.astro';
import { getPosts } from '../utils/posts';
import { journalSection } from '../data/home';

const posts = (await getPosts()).slice(0, 3);
---

{posts.length > 0 && (
  <section class="section" id="editorial" aria-labelledby="editorial-title">
    <div class="container">
      <SectionHeading id="editorial-title" title={journalSection.title} intro={journalSection.intro}>
        {journalSection.cta && <Button href={journalSection.cta.href} variant="line">{journalSection.cta.label}</Button>}
      </SectionHeading>
      <div class="journal">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    </div>
  </section>
)}
