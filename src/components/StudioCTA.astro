---
import Button from './Button.astro';

interface Props {
  title?: string;
  intro?: string;
  flush?: boolean;
}

const {
  title = '准备好告别卡顿与断流了吗？',
  flush = true,
  intro = '立即查看 TOP 1 光速云（99元/年 IEPL 专线，9折优惠码 AMM），或在 42 家机场评测库中按预算与客户端筛选最适合您的方案。',
} = Astro.props;
---

<section class:list={['section', { 'section--flush-top': flush }]} aria-labelledby="studio-cta-title">
  <div class="container">
    <div class="newsletter">
      <div>
        <h2 id="studio-cta-title">{title}</h2>
        <p>{intro}</p>
      </div>
      <div class="newsletter__actions">
        <Button href="/brands/guangsuyun/">直达 TOP 1 光速云</Button>
        <Button href="/brands/" variant="line">浏览 42 家机场库</Button>
      </div>
    </div>
  </div>
</section>
