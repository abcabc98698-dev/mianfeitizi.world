---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import MobileMenu from './MobileMenu.astro';
import { primaryNav, headerActions } from '../data/navigation';
import { url, currentPath } from '../utils/url';

const path = currentPath(Astro.url.pathname);

function current(href: string): 'page' | 'true' | undefined {
  if (href.includes('#')) return undefined;
  const cleanHref = href === '/' ? '/' : href.replace(/\/$/, '');
  if (cleanHref === path) return 'page';
  if (cleanHref !== '/' && path.startsWith(`${cleanHref}/`)) return 'true';
  return undefined;
}
---

<header class="site-header">
  <div class="container">
    <Logo />
    <nav class="nav" id="primary-nav" aria-label="Primary">
      {primaryNav.map((item) => (
        <a href={url(item.href)} aria-current={current(item.href)}>{item.label}</a>
      ))}
    </nav>
    <div class="header-actions">
      {headerActions.schedule && (
        <a class="btn btn--glass" href={url(headerActions.schedule.href)} aria-label={headerActions.schedule.ariaLabel}>
          <Icon name="calendar" /><span>{headerActions.schedule.label}</span>
        </a>
      )}
      {headerActions.memberships && (
        <a class="icon-btn btn--glass" href={url(headerActions.memberships.href)} aria-label={headerActions.memberships.ariaLabel}>
          <Icon name="bag" />
        </a>
      )}
      <MobileMenu />
    </div>
  </div>
</header>
