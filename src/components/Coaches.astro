---
import SectionHeading from './SectionHeading.astro';
import Button from './Button.astro';
import CoachCard from './CoachCard.astro';
import { coaches } from '../data/coaches';
import { coachesSection } from '../data/home';
---

<section class="section section--mist" id="instructors" aria-labelledby="instructors-title">
  <div class="container">
    <SectionHeading id="instructors-title" title={coachesSection.title} intro={coachesSection.intro}>
      {coachesSection.cta && <Button href={coachesSection.cta.href} variant="line">{coachesSection.cta.label}</Button>}
    </SectionHeading>
    <div class="coaches__grid">
      {coaches.map((coach) => <CoachCard coach={coach} />)}
    </div>
  </div>
</section>
