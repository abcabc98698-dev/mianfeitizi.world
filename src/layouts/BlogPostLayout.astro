---
import BaseLayout from './BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import PostCard from '../components/PostCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import StudioCTA from '../components/StudioCTA.astro';
import Icon from '../components/Icon.astro';
import { type Post, postMinutes } from '../utils/posts';
import { formatDate } from '../utils/format';
import { blogPostingSchema, breadcrumbSchema } from '../utils/schema';
import { url } from '../utils/url';

interface Props {
  post: Post;
  related: Post[];
}

const { post, related } = Astro.props;
const { title, description, image, imageAlt, author, category, tags, pubDate, updatedDate } = post.data;
const minutes = postMinutes(post);
const path = `/journal/${post.id}/`;
const crumbs = [
  { name: '首页', href: '/' },
  { name: '深度评测专栏', href: '/journal/' },
  { name: title, href: path },
];
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  imageAlt={imageAlt}
  type="article"
  publishedTime={pubDate}
  modifiedTime={updatedDate}
  author={author}
  category={category}
  tags={tags}
  schema={[
    blogPostingSchema(
      { title, description, image, author, category, tags, minutes, pubDate, updatedDate, path },
      Astro.site,
    ),
    breadcrumbSchema(crumbs, Astro.site),
  ]}
>
  <article>
    <PageHero image={{ src: image, alt: imageAlt }} title={title} lead={description} breadcrumbs={crumbs}>
      <div class="page-hero__meta">
        <span class="tag tag--glass">{category}</span>
        <span><Icon name="calendar" size={14} /><time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time></span>
        <span><Icon name="clock" size={14} />约 {minutes} 分钟阅读</span>
        <span>作者：{author}</span>
      </div>
    </PageHero>
    <div class="article container">
      <div class="prose">
        <slot />
      </div>
      <footer class="article__footer">
        {tags.length > 0 && (
          <ul class="article__tags" aria-label="文章标签">
            {tags.map((tag) => <li><span class="tag">#{tag}</span></li>)}
          </ul>
        )}
        <a class="link-arrow" href={url('/journal/')}>返回全部专栏文章 <Icon name="arrow-up" size={14} /></a>
      </footer>
    </div>
  </article>

  {related.length > 0 && (
    <section class="section" aria-labelledby="related-title">
      <div class="container">
        <SectionHeading id="related-title" title="延伸阅读推荐" />
        <div class="journal">
          {related.map((item) => <PostCard post={item} />)}
        </div>
      </div>
    </section>
  )}

  <StudioCTA />
</BaseLayout>
